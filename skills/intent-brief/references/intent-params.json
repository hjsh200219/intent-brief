  "intents": {
    "W": {
      "name": "전부 승소",
      "layer": "goal",
      "primary_allowed": true,
      "definition": "상대 주장 전부를 다투고 청구 전부 인용(원고, 인정 쟁점이 없을 때)·전부 기각(피고)을 구한다"
    },
    "M": {
      "name": "손해 최소화",
      "layer": "goal",
      "primary_allowed": true,
      "definition": "원고: 근거 있는 상대 항변은 금액을 특정해 인정하고 인정액을 공제한 나머지 인용을 구한다 / 피고: 일부 인정 + 감액·공제·책임 제한 예비적 항변"
    },
    "S": {
      "name": "조정·화해 유도",
      "layer": "goal",
      "primary_allowed": true,
      "definition": "판결보다 조정·화해로 끝내도록 재판부·상대방을 움직인다"
    },
    "P": {
      "name": "상대 입장 고정·증거 제출 압박",
      "layer": "tactic",
      "primary_allowed": true,
      "definition": "상대가 주장을 특정하게 하고 상대 보유 자료를 내게 한다"
    },
    "R": {
      "name": "쟁점 재구성",
      "layer": "framing",
      "primary_allowed": true,
      "definition": "재판부가 보는 사건의 틀(핵심 쟁점·순서)을 바꾼다"
    },
    "A": {
      "name": "상소 대비 기록",
      "layer": "tactic",
      "primary_allowed": true,
      "definition": "결과와 무관하게 주장·증거신청·이의를 기록에 남긴다"
    },
    "C": {
      "name": "의뢰인 보고·설득",
      "layer": "audience",
      "primary_allowed": false,
      "definition": "의뢰인이 서면 전략을 이해·수긍하게 한다(서면 본문은 바꾸지 않고 보고 요약을 따로 만든다)"
    }
  },
